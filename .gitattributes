# Normalize text to LF in the repository
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix scripts must stay LF
gradlew text eol=lf
*.sh text eol=lf

# Binary files
*.jar binary
*.zip binary
*.gz binary
*.png binary
*.jpg binary
*.ico binary
*.dll binary
*.exe binary
*.gguf binary
*.class binary
