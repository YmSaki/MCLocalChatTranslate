{
  "schemaVersion": 1,
  "id": "localchattranslate",
  "version": "${version}",
  "name": "Local Chat Translate",
  "icon": "assets/localchattranslate/icon.png",
  "description": "Local English-to-Japanese translation of Hypixel SkyBlock chat, NPC dialogue and item descriptions.",
  "license": "LGPL-3.0-only",
  "contact": {
    "sources": "https://github.com/YmSaki/MCLocalChatTranslate",
    "issues": "https://github.com/YmSaki/MCLocalChatTranslate/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": ["local.chattranslate.LocalChatTranslate"],
    "modmenu": ["local.chattranslate.ModMenuIntegration"]
  },
  "mixins": ["localchattranslate.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_version}"
  }
}
